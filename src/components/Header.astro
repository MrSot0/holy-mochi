---
import Mascota from './Mascota.astro';
import { site } from '../data/site';

const enlaces = [
  { href: '#nosotros', texto: 'Nosotros' },
  { href: '#sabores', texto: 'Sabores' },
  { href: '#retos', texto: 'Retos' },
  { href: '#ruleta', texto: 'Ruleta' },
  { href: '#preguntas', texto: 'Preguntas' },
];
---
<header id="cabecera" class="cabecera sticky top-0 z-30 border-b-[3px] border-tinta bg-arroz">
  <div class="mx-auto flex max-w-[1240px] items-center justify-between gap-x-8 gap-y-2 px-4 py-2 sm:px-8">
    <a href="#inicio" class="flex items-center gap-2.5 no-underline" aria-label={`${site.nombre}, ir al inicio`}>
      <Mascota nivel={1} ancho={44} camina="izq" />
      <span class="font-display text-[26px] leading-none text-chile-texto sm:text-[28px]">{site.nombre}</span>
    </a>

    <!-- Escritorio: menú en línea -->
    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex gap-6 whitespace-nowrap">
        {enlaces.map((e) => (
          <li><a href={e.href} class="inline-block py-2 underline-offset-4 hover:underline decoration-2">{e.texto}</a></li>
        ))}
      </ul>
    </nav>
    <a href="#tarjeta" class="btn hidden bg-oro !min-h-[44px] !px-5 !py-2 !text-base !shadow-pop-sm md:inline-flex">Junta stickers</a>

    <!-- Móvil: botón de menú -->
    <button
      id="menu-abrir"
      type="button"
      class="grid size-12 place-items-center rounded-full border-[3px] border-tinta bg-oro shadow-pop-sm md:hidden"
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label="Abrir menú"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>
</header>

<!-- Móvil: menú a pantalla completa con la mascota encima -->
<div
  id="menu-movil"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Menú"
  class="menu-movil fixed inset-0 z-50 flex-col items-center justify-center gap-6 overflow-y-auto overscroll-contain bg-pina bg-lunares px-6 py-16 text-center md:hidden [&:not([hidden])]:flex"
>
  <button
    id="menu-cerrar"
    type="button"
    class="absolute right-4 grid size-12 place-items-center rounded-full border-[3px] border-tinta bg-blanco shadow-pop-sm"
    style="top: calc(12px + env(safe-area-inset-top, 0px))"
    aria-label="Cerrar menú"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>

  <div class="menu-mascota">
    <Mascota nivel={1} ancho={130} />
  </div>
  <nav aria-label="Principal (móvil)">
    <ul class="flex flex-col items-center gap-2">
      {enlaces.map((e, i) => (
        <li class="menu-enlace" style={`--i:${i}`}>
          <a href={e.href} class="inline-block px-4 py-1.5 text-[clamp(30px,9vw,42px)] leading-tight">{e.texto}</a>
        </li>
      ))}
    </ul>
  </nav>
  <a href="#tarjeta" class="menu-enlace btn bg-oro" style={`--i:${enlaces.length}`}>Junta los 4 stickers</a>
</div>

<script>
  const abrir = document.getElementById('menu-abrir') as HTMLButtonElement | null;
  const cerrar = document.getElementById('menu-cerrar') as HTMLButtonElement | null;
  const menu = document.getElementById('menu-movil');

  // Se oculta al bajar y vuelve al subir
  const cabecera = document.getElementById('cabecera');
  if (cabecera) {
    let ultimo = scrollY;
    let pendiente = false;
    addEventListener('scroll', () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        const y = scrollY;
        const bajando = y > ultimo + 4;
        const subiendo = y < ultimo - 4;
        const menuAbierto = menu && !menu.hidden;
        if (bajando && y > cabecera.offsetHeight * 2 && !menuAbierto && !cabecera.contains(document.activeElement)) cabecera.classList.add('oculta');
        else if (subiendo || y < cabecera.offsetHeight) cabecera.classList.remove('oculta');
        if (bajando || subiendo) ultimo = y;
        pendiente = false;
      });
    }, { passive: true });
    cabecera.addEventListener('focusin', () => cabecera.classList.remove('oculta'));
  }

  if (abrir && cerrar && menu) {
    const enfocables = () => [...menu.querySelectorAll<HTMLElement>('a, button')];

    const cerrarMenu = (devolverFoco = true) => {
      menu.hidden = true;
      abrir.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      if (devolverFoco) abrir.focus();
    };

    abrir.addEventListener('click', () => {
      menu.hidden = false;
      abrir.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      menu.querySelector<HTMLElement>('nav a')?.focus();
    });
    cerrar.addEventListener('click', () => cerrarMenu());
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => cerrarMenu(false)));

    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') cerrarMenu();
      if (e.key !== 'Tab') return;
      // mantiene el foco dentro del menú
      const lista = enfocables();
      const primero = lista[0];
      const ultimo = lista[lista.length - 1];
      if (e.shiftKey && document.activeElement === primero) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        primero.focus();
      }
    });

    // si se agranda la ventana a escritorio con el menú abierto, se cierra
    matchMedia('(min-width: 768px)').addEventListener('change', (m) => m.matches && !menu.hidden && cerrarMenu(false));
  }
</script>
