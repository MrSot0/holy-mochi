---
import MochiSabor from './MochiSabor.astro';
import Llamas from './Llamas.astro';
import { dulces, picantes, type Sabor } from '../data/menu';

// ancho de cada tarjeta en escritorio según cuántos sabores tiene el grupo
const anchoLg: Record<number, string> = { 3: 'lg:w-[calc((100%-40px)/3)]', 4: 'lg:w-[calc((100%-60px)/4)]' };
const grupos: { titulo: string; kanji: string; color: string; sabores: Sabor[] }[] = [
  { titulo: 'Dulces', kanji: '甘', color: '', sabores: dulces },
  { titulo: 'Picantes', kanji: '辛', color: 'text-chile-texto', sabores: picantes },
];
---
<section id="sabores" data-nivel="2" class="seccion bg-arroz bg-ichimatsu" aria-labelledby="sabores-titulo">
  <div class="contenedor flex flex-col gap-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="sabores-titulo" class="font-display text-[clamp(40px,6vw,76px)] leading-none">Los sabores</h2>
      <p class="max-w-[24em] rounded-2xl border-[3px] border-tinta bg-blanco px-3.5 py-2.5">Todos a $1 la unidad. Las llamas marcan el nivel de picante.</p>
    </div>

    {grupos.map((g) => (
      <div class="flex flex-col gap-4">
        <h3 class:list={['font-display text-[32px]', g.color]}>{g.titulo} <span class="text-[22px]" lang="ja">{g.kanji}</span></h3>
        <!-- Todas las tarjetas comparten estilo: mochi asomando arriba, nombre, descripción y pie con llamas y precio -->
        <ul class="flex flex-wrap justify-center gap-x-5 gap-y-16 pt-12">
          {g.sabores.map((s) => (
            <li id={`sabor-${s.id}`} class:list={['flex w-full scroll-mt-32 flex-col gap-2 rounded-[28px] border-[3px] border-tinta p-6 pt-0 shadow-pop-lg sm:w-[calc((100%-20px)/2)]', anchoLg[g.sabores.length], s.fondo]}>
              <MochiSabor id={s.id} ancho={110} class="-mt-16 mb-1 self-center" />
              <h4 class="font-display text-[clamp(24px,2.4vw,28px)] leading-tight">{s.nombre}</h4>
              <p>{s.descripcion}</p>
              <div data-no-centrar class="mt-auto flex items-center justify-between border-t-[3px] border-dotted border-tinta pt-2 font-bold">
                <Llamas cantidad={s.llamas} />
                <span>{s.precio}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
