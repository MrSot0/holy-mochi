---
import Mascota from './Mascota.astro';
import MochiSabor from './MochiSabor.astro';
import { retos, type Nivel } from '../data/menu';
import { site } from '../data/site';

const sellos: { nivel: Nivel; fondo: string }[] = retos.map((r) => ({ nivel: r.nivel, fondo: r.talon }));
---
<section id="tarjeta" data-nivel="4" class="seccion border-t-[3px] border-tinta bg-fresa bg-lunares" aria-labelledby="tarjeta-titulo">
  <div class="contenedor flex flex-col items-center gap-10 text-center">
    <div class="flex items-end justify-center gap-2" aria-hidden="true">
      <MochiSabor id="chocolate" ancho={90} camina="izq" />
      <Mascota nivel={4} ancho={130} camina="der" />
      <MochiSabor id="pinaparchita" ancho={90} camina="der" />
    </div>
    <div class="flex flex-col items-center gap-4">
      <h2 id="tarjeta-titulo" class="text-[clamp(36px,6vw,80px)] leading-none">La tarjeta de retos</h2>
      <p class="max-w-[30em] text-[19px]">Cada reto que superas es un sello. Completa los cuatro niveles y te llevas {site.premio}. Sí, te estamos haciendo comprar más. Y tú a nosotros sudar de orgullo.</p>
    </div>

    <!-- La tarjeta: un sello por nivel -->
    <div class="w-full max-w-[720px] rounded-[28px] border-[3px] border-tinta bg-blanco p-5 shadow-pop-lg sm:p-7">
      <div data-no-centrar class="mb-4 flex items-center justify-between gap-3 border-b-[3px] border-dashed border-tinta/40 pb-3">
        <span class="text-[22px] text-chile-texto">{site.nombre}</span>
        <span class="text-[15px]">Tarjeta de retos</span>
      </div>
      <ol class="grid grid-cols-2 gap-4 sm:grid-cols-4" aria-label="Sellos de la tarjeta">
        {sellos.map((s) => (
          <li class="flex flex-col items-center gap-2">
            <span class:list={['grid aspect-square w-full max-w-[120px] place-items-center rounded-full border-[3px] border-dashed border-tinta', s.fondo]}>
              <Mascota nivel={s.nivel} ancho={70} />
            </span>
            <span class="text-[15px]">Nivel {s.nivel}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="flex flex-wrap justify-center gap-4">
      <a href="#retos" class="btn bg-oro">Ver los retos</a>
      <a href="#sabores" class="btn bg-blanco">Ver la carta</a>
    </div>
    <p class="text-[14px]">Un mochi gratis por tarjeta completa. [CONDICIONES Y VIGENCIA]</p>
  </div>
</section>

<footer class="border-t-[3px] border-tinta bg-pina px-5 pt-8 pb-40 text-center">
  <p class="text-[22px] text-chile-texto">{site.nombre}</p>
  <p>Mochis que pican en {site.ciudad} · {site.dondeComprar}</p>
  <p class="text-[14px]">© {new Date().getFullYear()} {site.nombre}</p>
</footer>
