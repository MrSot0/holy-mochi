---
import Mascota from './Mascota.astro';
import { nivelesMascota } from '../data/menu';
import { site } from '../data/site';
---
<section id="nosotros" data-nivel="1" class="seccion bg-cielo" aria-labelledby="nosotros-titulo">
  <div class="contenedor flex flex-wrap items-center gap-x-[72px] gap-y-10">
    <div class="flex min-w-0 flex-[1_1_460px] flex-col gap-5">
      <h2 id="nosotros-titulo" class="text-[15px] font-bold tracking-[.12em] uppercase">Nosotros</h2>
      <p class="font-display text-[clamp(34px,4.6vw,58px)] leading-[1.05]">Empieza dulce. Termina en llamas.</p>
      <p class="max-w-[34em]">
        Holy Mochi mezcla el mochi japonés con fruta tropical y chile. Cada mochi lleva su medidor de picante para que sepas en qué te metes.
      </p>
      <p class="max-w-[34em] rounded-2xl border-[3px] border-dashed border-tinta bg-blanco px-4 py-3">{site.historia}</p>
    </div>
    <ul class="grid flex-[1_1_380px] grid-cols-2 gap-3.5" aria-label="Niveles de picante de la mascota">
      {nivelesMascota.map((n) => (
        <li class:list={['flex flex-col items-center rounded-3xl border-[3px] border-tinta p-3.5 text-center', n.fondo]}>
          <Mascota nivel={n.nivel} ancho={110} />
          <b>{n.nivel} · {n.nombre}</b>
          <span class="text-[15px]">{n.gesto}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
