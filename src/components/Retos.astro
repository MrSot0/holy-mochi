---
import MochiSabor from './MochiSabor.astro';
import { retos } from '../data/menu';
import { site } from '../data/site';

// Escalera: cada nivel un poco más alto que el anterior
const alturas = ['', 'lg:min-h-[395px]', 'lg:min-h-[415px]', 'lg:min-h-[435px]'];
const pasos = [
  { titulo: 'Elige tu nivel', texto: 'Del 1 al 4, según cuánto aguantes.' },
  { titulo: 'Compra el mochi del reto', texto: 'Todos a $1. Sin trampas.' },
  { titulo: 'Sella tu tarjeta', texto: 'Supera el reto al momento y te ponemos el sello.' },
];
---
<section id="retos" data-nivel="3" class="seccion bg-mango bg-rayas" aria-labelledby="retos-titulo">
  <div class="contenedor flex flex-col gap-12">
    <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
      <h2 id="retos-titulo" class="font-display text-[clamp(40px,6vw,76px)] leading-none">Tickets de reto</h2>
      <p class="max-w-[26em] text-[19px] leading-normal">
        Compra el mochi de tu nivel y supéralo al momento. Cada reto superado es un sello: con los cuatro te llevas {site.premio}.
      </p>
    </div>

    <ul class="grid grid-cols-1 items-end gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {retos.map((r, i) => (
        <li class:list={[
          'flex overflow-hidden rounded-3xl border-[3px] border-tinta bg-blanco lg:flex-col-reverse lg:justify-end',
          r.nivel === 4 ? 'shadow-pop-chile' : 'shadow-pop-lg',
          alturas[i],
        ]}>
          <div class="flex flex-1 flex-col gap-2 p-6 lg:p-5">
            <span class:list={['text-[15px] font-bold', r.nivel === 4 && 'text-chile-texto']}>Nivel {r.nivel}</span>
            <h3 class="font-display text-[28px] leading-tight lg:text-[25px]">{r.nombre}</h3>
            <p>{r.descripcion}</p>
            {r.juego && (
              <a href="#ruleta" data-abrir-juego={r.juego} class="btn mt-1 self-start bg-oro !min-h-[40px] !px-4 !py-1.5 !text-[15px] !shadow-pop-sm">Abrir la caja</a>
            )}
          </div>
          <div class:list={['flex w-24 shrink-0 items-center justify-center border-l-[3px] border-dashed border-tinta lg:w-full lg:border-b-[3px] lg:border-l-0 lg:py-3', r.talon]}>
            {r.sabor ? (
              <MochiSabor id={r.sabor} ancho={76} />
            ) : (
              <span class="relative flex w-[60px] flex-col items-center" aria-hidden="true">
                <span class="block h-3.5 w-[66px] rounded-lg border-[3px] border-tinta bg-fresa-fuerte"></span>
                <span class="relative -mt-[3px] grid aspect-square w-full place-items-center rounded-b-xl border-[3px] border-tinta bg-fresa">
                  <span class="absolute inset-y-0 left-1/2 w-3 -translate-x-1/2 border-x-[3px] border-tinta bg-fresa-fuerte"></span>
                  <span class="relative rounded-full border-[3px] border-tinta bg-blanco px-1.5 text-[15px] leading-tight">?</span>
                </span>
              </span>
            )}
          </div>
        </li>
      ))}
    </ul>

    <ol class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4" aria-label="Cómo funciona">
      {pasos.map((p, i) => (
        <li class="flex items-center gap-3.5 rounded-[20px] border-[3px] border-tinta bg-arroz px-5 py-4">
          <span class="font-display text-[44px] leading-none" aria-hidden="true">{i + 1}</span>
          <div><b>{p.titulo}</b><p>{p.texto}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>
