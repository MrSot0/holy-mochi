---
import Mascota from './Mascota.astro';
import type { Nivel } from '../data/menu';

const niveles: Nivel[] = [1, 2, 3, 4];
---
<!-- Mascota que sube de nivel al bajar y suelta comentarios (ver src/scripts/acompanante.ts) -->
<div
  id="acompanante"
  data-nivel="1"
  data-camina="der"
  aria-hidden="true"
  class="pointer-events-none fixed right-3 z-20 aspect-[240/280] w-[clamp(72px,16vw,120px)]"
  style="bottom: calc(12px + env(safe-area-inset-bottom, 0px))"
>
  {niveles.map((n) => (
    <div data-capa={n} class="absolute inset-0 opacity-0 transition-opacity duration-300">
      <Mascota nivel={n} ancho={120} class="size-full" />
    </div>
  ))}
  <p
    id="acompanante-globo"
    class="globo absolute right-[70%] bottom-[92%] w-[min(220px,58vw)] rounded-[20px] border-[3px] border-tinta bg-arroz px-3.5 py-2.5 text-[14px] leading-snug shadow-pop-sm sm:text-[15px]"
  ></p>
</div>

<style>
  #acompanante { transition: opacity .3s, translate .4s cubic-bezier(.3,1.4,.5,1); }
  #acompanante.apartado { opacity: 0; translate: 140% 0; }
  #acompanante[data-nivel="1"] [data-capa="1"],
  #acompanante[data-nivel="2"] [data-capa="2"],
  #acompanante[data-nivel="3"] [data-capa="3"],
  #acompanante[data-nivel="4"] [data-capa="4"] { opacity: 1; }
  .globo { opacity: 0; transform: scale(.6) translateY(12px); transform-origin: 90% 100%; transition: opacity .25s, transform .35s cubic-bezier(.3,1.6,.5,1); }
  .globo::after { content: ""; position: absolute; right: 14px; bottom: -11px; width: 16px; height: 16px; background: inherit; border-right: 3px solid var(--color-tinta); border-bottom: 3px solid var(--color-tinta); transform: rotate(45deg); }
  .globo.visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .globo { transition: opacity .2s; transform: none; } }
</style>

<script>
  import { iniciarAcompanante } from '../scripts/acompanante';
  iniciarAcompanante();
</script>
