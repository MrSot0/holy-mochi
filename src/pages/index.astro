---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquesina from '../components/Marquesina.astro';
import Nosotros from '../components/Nosotros.astro';
import Sabores from '../components/Sabores.astro';
import Retos from '../components/Retos.astro';
import Ruleta from '../components/Ruleta.astro';
import Preguntas from '../components/Preguntas.astro';
import Pie from '../components/Pie.astro';
import Acompanante from '../components/Acompanante.astro';
---
<Base
  titulo="Holy Mochi · Mochis que pican, mochis que retan"
  descripcion="Mochis en Maracaibo: piña, fresa, parchita y chocolate, y picantes de ají, pimienta, cayena, piri piri y tabasco. Todos a $1. Supera los cuatro retos y llévate un mochi gratis."
>
  <Header />
  <main id="contenido">
    <Hero />
    <Marquesina />
    <Nosotros />
    <Sabores />
    <Retos />
    <Ruleta />
    <Preguntas />
  </main>
  <Pie />
  <Acompanante />
</Base>
